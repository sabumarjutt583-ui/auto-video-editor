{
  "configVersion": "1.5",
  "toolUrl": "https://share.gemini.google/rqUWVwvowbjG",
  "signInUrl": "https://accounts.google.com/ServiceLogin?continue={continueUrl}",
  "signInContinueUrl": "https://gemini.google.com/app",
  "model": "gemini-3.1-flash-image",
  "signedInTitle": ["Gemini"],
  "stillSigningInTitle": ["Sign in", "Google Accounts", "Verify", "Verification", "Choose an account"],
  "toolAspectRatios": ["16:9", "1:1", "9:16"],
  "maxParallel": 8,
  "selectors": {
    "continueButton": { "css": "mat-dialog-container button, [role=\"dialog\"] button", "text": "^\\s*Continue\\s*$" },
    "signInLink": "a[href*=\"accounts.google.com/ServiceLogin\"], a[href*=\"accounts.google.com/v3/signin\"]",
    "accountButton": "a[aria-label^=\"Google Account\"], button[aria-label^=\"Google Account\"]",
    "promptsTab": "#tabPrompts",
    "promptInput": "#rawPromptsInput",
    "submit": "#addQueueAndGenBtn",
    "parallel": "#parallelRange",
    "ratioButton": ".ratio-btn[data-ratio=\"{ratio}\"]",
    "total": "#cntTotal",
    "queued": "#cntQueued",
    "generating": "#cntGenerating",
    "grid": "#resultsGrid",
    "allFilter": ".filter-chip[data-filter=\"all\"]",
    "search": "#searchInput",
    "clearBatch": "#clearBatchBtn",
    "cardError": "div.truncate"
  },
  "timing": {
    "pollMs": 1500,
    "pageLoadTimeoutMs": 90000,
    "submitConfirmMs": 10000,
    "lostCardMs": 15000,
    "clearAfterTasks": 30,
    "signedInSettleMs": 3000
  },
  "chat": {
    "url": "https://gemini.google.com/app",
    "selectors": {
      "input": "div.ql-editor[role=\"textbox\"]",
      "send": "button[aria-label=\"Send message\"]",
      "response": "model-response",
      "responseText": "message-content",
      "codeBlock": "code-block pre",
      "done": "button[aria-label=\"Good response\"]",
      "stop": "button[aria-label=\"Stop response\"]",
      "thinking": "model-response .loading, .thinking-indicator",
      "attach": "button[aria-label=\"Open upload file menu\"]",
      "uploadItem": "button[data-test-id=\"local-images-files-uploader-button\"]",
      "fileInput": "input[type=\"file\"]",
      "attachment": "uploader-file-preview"
    },
    "timing": { "pageReadyMs": 30000, "sendEnableMs": 30000, "replyStartMs": 180000, "pollMs": 700, "stableMs": 9000, "uploadMs": 45000, "thinkMaxMs": 300000, "finishStableMs": 2000 },
    "limitTexts": ["reached your limit", "usage limit", "limit for today", "try again tomorrow", "come back later", "reached the limit"],
    "errorTexts": ["something went wrong", "i'm having trouble", "couldn't complete"],
    "softFailureTexts": ["encountering an error", "having a hard time fulfilling", "something else instead", "can't help with that", "cannot help with that"]
  },
  "video": {
    "toolsButton": "button[aria-label=\"Open upload file menu\"]",
    "menuItem": "button, [role=\"menuitem\"], [role=\"option\"], .mat-mdc-menu-item, .mdc-list-item",
    "createText": "^\\s*Create video\\s*$",
    "modeHint": "Describe your video",
    "video": "model-response video",
    "readyTexts": ["your video is ready"],
    "limitTexts": ["out of videos", "videos will be available again", "as soon as your limit resets", "video limit"],
    "errorTexts": ["couldn't generate", "could not generate", "unable to generate", "something went wrong", "can't create that video", "cannot create that video"],
    "resetRegex": "available again on\\s+([A-Za-z]{3,9})\\.?\\s+(\\d{1,2})\\s+at\\s+(\\d{1,2}:\\d{2}\\s*[AaPp][Mm])",
    "moreButton": "model-response button[aria-label*=\"more\" i]",
    "downloadText": "^\\s*Download video\\s*$",
    "defaultRestMinutes": 360,
    "maxWaitMs": 900000,
    "pollMs": 1500,
    "downloadMs": 120000
  },
  "flow": {
      "url": "https://flow.google.com/",
      "projectUrlPart": "/project/",
      "newProjectText": "^\\s*\\+?\\s*New project\\s*$",
      "promptInput": "[contenteditable=\"true\"], textarea, [role=\"textbox\"]",
      "sendButton": "button[aria-label*=\"send\" i], button[aria-label*=\"generate\" i], button[aria-label*=\"create\" i]",
      "chipText": "^\\s*(Video\\s*·|.*Nano Banana|Veo|Omni)",
      "videoTab": "^\\s*Video\\s*$",
      "framesTab": "^\\s*Frames\\s*$",
      "ingredientsTab": "^\\s*Ingredients\\s*$",
      "ratio": "16:9",
      "model": "Veo 3.1 - Lite",
      "modelLabel": "^\\s*(Veo 3\\.1 - \\w+|Omni [\\d.]+ \\w+)\\s*$",
      "resolution": "720p",
      "seconds": 8,
      "count": 1,
      "maxCreditsPerVideo": 20,
      "costRegex": "Generating will use\\s+([\\d,]+)\\s+credits",
      "balanceRegex": "([\\d,]+)\\s+Google Flow credits",
      "accountButton": "button:has(img[src*=\"googleusercontent\"]), button[aria-label*=\"account\" i]",
      "startSlot": "^\\s*Start\\s*$",
      "uploadText": "^\\s*Upload media\\s*$",
      "addToPrompt": "^\\s*Add to prompt\\s*$",
      "progressRegex": "^\\s*\\d{1,3}%\\s*$",
      "moreButton": "button[aria-label*=\"more\" i]",
      "downloadText": "^\\s*Download\\s*$",
      "qualityText": "^\\s*720p[\\s\\S]*Original size",
      "videoMenuMarker": "Publish to YouTube",
      "imageMenuMarker": "Animate",
      "limitTexts": [
          "not enough credits",
          "out of credits",
          "insufficient credits",
          "no credits left",
          "run out of credits"
      ],
      "errorTexts": [
          "something went wrong",
          "couldn't generate",
          "could not generate",
          "unable to generate",
          "generation failed"
      ],
      "blockTexts": [
          "unusual activity",
          "unusual traffic",
          "not a robot",
          "verify it's you",
          "verify it’s you"
      ],
      "defaultRestMinutes": 720,
      "startWaitMs": 120000,
      "maxWaitMs": 900000,
      "pollMs": 1500,
      "downloadMs": 120000
  },
  "errorPatterns": [
    { "contains": ["API Error 429"], "kind": "rate_limit", "message": "Usage limit reached for this Google account." },
    { "contains": ["API Error 401", "API Error 403"], "kind": "auth", "message": "Google refused the request: the account is signed out." },
    { "contains": ["API Error 404"], "kind": "access", "message": "The image model is not available to this Google account." },
    { "contains": ["PROHIBITED_CONTENT", "blocked by safety", "SAFETY", "content policy"], "kind": "blocked", "message": "Google refused this prompt (content rules)." },
    { "contains": ["API Error 400"], "kind": "bad_request", "message": "Google rejected this prompt." },
    { "contains": ["API Error 5"], "kind": "server", "message": "Google had a temporary server problem." },
    { "contains": ["No image data returned"], "kind": "no_image", "message": "Google answered without an image (often a prompt it will not draw)." },
    { "contains": ["Failed to fetch", "NetworkError", "network"], "kind": "network", "message": "Could not reach Google (network problem)." }
  ],
  "humanChecks": [
    { "contains": ["unusual traffic", "unusual activity", "not a robot", "captcha", "suspicious activity"], "kind": "flagged", "message": "Google is asking for a check (captcha or unusual activity). Open this account's browser window and finish it yourself. The account is paused." },
    { "contains": ["verify it's you", "verify it’s you", "2-step verification", "confirm it's you", "confirm it’s you"], "kind": "auth", "message": "Google wants to check that it is you. Click Sign in and finish the check in the window." },
    { "contains": ["terms of service", "accept the terms", "before you continue", "age verification"], "kind": "access", "message": "Google is asking you to accept something (terms or an age check). Click Sign in and finish it in the window, then close it." }
  ]
}
