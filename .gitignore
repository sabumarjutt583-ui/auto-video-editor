node_modules
dist
*.local
*.log

# FFmpeg sidecars are downloaded by `npm run setup:ffmpeg` (large binaries)
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
dist-packages

# Updater signing keys: never commit (see RELEASE.md)
*.key
.tauri-keys/
.tauri/

# Secrets and local settings: never commit. (.env.admin only holds the non-secret flag VITE_ADMIN=true.)
.env*
!.env.admin
*.key
!*.key.pub
*.pem
*.p12

# Build output (this also covers the Rust build output: src-tauri/target and src-tauri/gen — the duplicate lines for those paths that used to appear above were removed in fix/remaining-gaps-phase1)
dist/
src-tauri/target/
src-tauri/gen/
*.map

# Reference code from a third party (read-only, never pushed)
vendor/
tests/output/
